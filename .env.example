# Database configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=qbank_db

# Backend configuration
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/qbank_db
SECRET_KEY=your_secret_key_here
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5176,http://localhost:8000,http://localhost

# LLM configuration (Local LLM via Ollama or LM Studio)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3
LLM_API_KEY=lm-studio
