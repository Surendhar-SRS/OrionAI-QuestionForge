# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=qbank_db

# Application Configuration
# Note: DATABASE_URL is used by the backend application to connect to the database.
# When running with Docker Compose, 'db' is the hostname of the database container.
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/qbank_db

# JWT Secret Key - Generate a secure one with 'openssl rand -hex 32'
SECRET_KEY=change-me-in-production
